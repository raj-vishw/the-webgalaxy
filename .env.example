# Public galaxy (Vite). Only VITE_* variables reach the browser — never put secrets here.
# API base URL. Leave unset to use `/api` (same-origin in Vercel and proxied to
# the backend in development).
# VITE_API_URL=https://api.webgalaxy.example/api
# Where the dev server proxies /api (development only).
# VITE_API_PROXY=http://localhost:4000
