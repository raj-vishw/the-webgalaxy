# ─── The WebGalaxy API ────────────────────────────────────────────────────────
# Copy to `.env` and adjust. Never commit `.env`.

# PostgreSQL connection string. Leave unset to run on an embedded PostgreSQL
# (PGlite) stored in ./data — zero setup for development. Hosting integrations
# that provide POSTGRES_URL / POSTGRES_PRISMA_URL / DATABASE_URL_UNPOOLED
# instead are picked up automatically.
# DATABASE_URL=postgresql://webgalaxy:webgalaxy@localhost:5432/webgalaxy

# Where the embedded database lives when DATABASE_URL is unset ("memory://" for tests).
PGLITE_DIR=./data/pglite

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated origins allowed to call the API (the public galaxy).
CORS_ORIGINS=http://localhost:5173

# Secret used to sign session tokens. Generate one: `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string

# The single sign-in for content management. The API keeps the database in
# step with these values on every start: the account is created or updated,
# and any other account is removed. Change the password here and restart.
ADMIN_EMAIL=admin@webgalaxy.local
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Galaxy Admin

# Rate limits (requests per window).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_SEARCH=60
RATE_LIMIT_SUBMIT=5
