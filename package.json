{
  "name": "the-webgalaxy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace backend",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm run build --workspace backend",
    "lint": "oxlint src api backend/src",
    "typecheck": "tsc -p api/tsconfig.json && npm run typecheck --workspace backend",
    "test": "vitest run && npm test --workspace backend",
    "test:web": "vitest run",
    "test:api": "npm test --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend --",
    "preview": "vite preview",
    "test:e2e": "node e2e/galaxy.e2e.mjs && node e2e/platform.e2e.mjs && node e2e/console.e2e.mjs",
    "test:e2e:mobile": "node e2e/galaxy.e2e.mjs --mobile && node e2e/platform.e2e.mjs --mobile",
    "import:curlie": "npm run import:curlie --workspace backend --",
    "logos": "npm run logos --workspace backend --",
    "layout": "npm run layout --workspace backend --"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "backend"
  ]
}
